				<defaultProjectile>CGF1_MWP_Bullet_545x39mm_Auto</defaultProjectile>
				<warmupTime>1.95</warmupTime>
				<range>33.9</range>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_MG_Medium9</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.58,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<comps>
			<li Class="WeaponSwitch.CompProperties_SwitchWeapon">
				<weaponsToSwitch>
					<li>
						<label>Attach suppressor</label>
						<description>Suppressor is not currently attached. Click to install.</description>
						<texPath>CGF1/UI/Fix_Suppressor</texPath>
						<weapon>CGF1_MWP_RPK74N2_1P78_SD_</weapon>
						<retainAmmoOnTransfer>true</retainAmmoOnTransfer>
						<ticksToSwitchWeapon>240</ticksToSwitchWeapon>
					</li>
				</weaponsToSwitch>
			</li>
		</comps>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
	</ThingDef>
	
