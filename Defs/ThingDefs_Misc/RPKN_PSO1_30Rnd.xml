<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="CGF1_MWP_LMG_MagFed_T1">
		<defName>CGF1_MWP_RPKN_PSO1_30Rnd_</defName>
		<label>RPKN (PSO-1 30Rnd)</label>
		<description>Caliber: 7.62x39mm. 30-round detachable mag. Select-Fire.
		
The RPK is a Soviet light machine gun (LMG) derived from the AK rifle. First produced in 1961, the RPK replaced the earlier RPD machine gun in an effort to standardize the small arms in use by USSR forces at the time - the RPK is built on an AK receiver and thus shares many of its parts (such as the grip and magazines.)

The RPKN variant has a Warsaw Pact rail on the left side of the receiver, allowing it to mount various optics. This one has been fitted with a PSO-1 4x24 telescopic scope.</description>
		<graphicData>
			<texPath>CGF1/Gun/RPKN_PSO1_30Rnd</texPath>
			<drawSize>1.01</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>75</Steel>
			<ComponentIndustrial>7</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>45000</WorkToMake>
			<Mass>4.8</Mass>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.60</AccuracyMedium>
			<AccuracyLong>0.50</AccuracyLong>
			<RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_LMG_Military</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedHeavy</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSSR</li>
			<li>CGF1_GunsGalore_ColdWarUSSR_LMG</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x39mm_Auto</defaultProjectile>
				<warmupTime>2.3</warmupTime>
				<range>36.9</range>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Auto6</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.58,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<comps>
			<li Class="WeaponSwitch.CompProperties_SwitchWeapon">
				<weaponsToSwitch>
					<li>
						<label>Attach suppressor</label>
						<description>Suppressor is not currently attached. Click to install.</description>
						<texPath>CGF1/UI/Fix_Suppressor</texPath>
						<weapon>CGF1_MWP_RPKN_PSO1_30Rnd_SD_</weapon>
						<retainAmmoOnTransfer>true</retainAmmoOnTransfer>
						<ticksToSwitchWeapon>240</ticksToSwitchWeapon>
					</li>
				</weaponsToSwitch>
			</li>
		</comps>
		<generateCommonality>0.20</generateCommonality> <!-- Common -->
	</ThingDef>
	
