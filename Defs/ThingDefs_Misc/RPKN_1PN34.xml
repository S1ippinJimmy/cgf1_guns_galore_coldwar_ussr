			<texPath>CGF1/Gun/RPKN_1PN34</texPath>
			<drawSize>1.01</drawSize>
		</graphicData>
		<recipeMaker>
			<recipeUsers>
				<li>CGF1_MWP_Building_Gunsmith</li>
			</recipeUsers>
			<researchPrerequisite>CGF1_MWP_Research_T8_AtomicAgeFirearms</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Steel>75</Steel>
			<ComponentIndustrial>9</ComponentIndustrial>
		</costList>
		<statBases>
			<WorkToMake>47500</WorkToMake>
			<Mass>5.3</Mass>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.60</AccuracyMedium>
			<AccuracyLong>0.50</AccuracyLong>
			<RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>40</equippedAngleOffset>
		<weaponTags>
			<li>CGF1_LMG_Military</li>
		</weaponTags>
		<weaponClasses>
			<li>RangedHeavy</li>
		</weaponClasses>
		<tradeTags>
			<li>CGF1_GunsGalore_ColdWarUSSR</li>
			<li>CGF1_GunsGalore_ColdWarUSSR_LMG</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CGF1_MWP_Bullet_762x39mm_Auto</defaultProjectile>
				<warmupTime>1.95</warmupTime>
				<range>33.9</range>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>CGF1_MWP_SFX_Rifle_Auto6</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="issaczhuang.muzzleflash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.7,0.7)</drawSize>
				<offsets>
					<li>(0.58,0.05)</li>
				</offsets>
			</li>
		</modExtensions>
		<comps>
			<li Class="WeaponSwitch.CompProperties_SwitchWeapon">
				<weaponsToSwitch>
					<li>
						<label>Attach suppressor</label>
						<description>Suppressor is not currently attached. Click to install.</description>
						<texPath>CGF1/UI/Fix_Suppressor</texPath>
						<weapon>CGF1_MWP_RPKN_1PN34_SD_</weapon>
						<retainAmmoOnTransfer>true</retainAmmoOnTransfer>
						<ticksToSwitchWeapon>240</ticksToSwitchWeapon>
					</li>
				</weaponsToSwitch>
			</li>
		</comps>
		<generateCommonality>0.05</generateCommonality> <!-- Uncommon -->
	</ThingDef>
	
